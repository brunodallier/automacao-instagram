# Copie para .env. Use credenciais próprias; nunca versione .env.
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@localhost:5432/automacao_instagram?schema=public"
POSTGRES_USER="SEU_USUARIO"
POSTGRES_PASSWORD="SUA_SENHA"
POSTGRES_DB="automacao_instagram"
POSTGRES_PORT="5432"
NEXTAUTH_URL="http://localhost:3000"
# Gere: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=""
# Testes de integração e navegador exigem um banco separado cujo nome contenha 'test'.
TEST_DATABASE_URL=""
# Instagram Login: somente no servidor; nunca use NEXT_PUBLIC_ para tokens.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_API_VERSION="v25.0"
# Manter desativado até autorização específica e teste controlado.
INSTAGRAM_SEND_MODE="disabled"
INSTAGRAM_META_VALIDATED="false"
INSTAGRAM_WEBHOOK_ENABLED="false"
INSTAGRAM_EXECUTION_ACCOUNT_ID=""
# Instagram app secret do produto Instagram Login, usado no HMAC dos webhooks.
# Pode diferir do segredo do App ID geral. Configure só no ambiente privado.
INSTAGRAM_APP_SECRET=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
INSTAGRAM_TEST_COMMENT_ID=""
INSTAGRAM_TEST_RECIPIENT_ID=""
INSTAGRAM_SUBSCRIPTION_SETUP_APPROVED="false"
