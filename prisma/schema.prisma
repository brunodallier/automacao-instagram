generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  KWAI
}

enum SocialConnectionStatus {
  NOT_CONNECTED
  CONNECTED
  EXPIRED
  ERROR
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ERROR
}

enum AutomationScope {
  GLOBAL
  FUTURE_REELS
  SPECIFIC_REELS
}

enum AutomationStepKind {
  SEND_DM
  BUTTONS
  ADD_TAG
  DELAY
  PUBLIC_REPLY
}

model User {
  id             String                @id @default(cuid())
  name           String
  email          String                @unique
  passwordHash   String
  sessionVersion Int                   @default(0)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  memberships    WorkspaceMembership[]
}

model Workspace {
  id           String                @id @default(cuid())
  name         String
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)
  memberships  WorkspaceMembership[]
  tags         Tag[]
  socialAccounts SocialAccount[]
  automations  Automation[]
}

model WorkspaceMembership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Tag {
  id             String    @id @default(cuid())
  workspaceId    String
  name           String    @db.VarChar(50)
  normalizedName String    @db.VarChar(50)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationSteps AutomationStep[]

  @@unique([workspaceId, normalizedName])
  @@index([workspaceId, createdAt])
}

model Automation {
  id             String             @id @default(cuid())
  workspaceId    String
  name           String             @db.VarChar(80)
  nameIsProvisional Boolean         @default(false)
  publicReplies     Json?
  status         AutomationStatus   @default(DRAFT)
  scope          AutomationScope     @default(GLOBAL)
  lastExecutedAt DateTime?          @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  keywords       AutomationKeyword[]
  steps          AutomationStep[]
  reels          AutomationReel[]

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, status])
}

model AutomationKeyword {
  id             String     @id @default(cuid())
  automationId   String
  value          String     @db.VarChar(40)
  normalizedValue String    @db.VarChar(40)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, normalizedValue])
  @@index([automationId, createdAt])
}

model AutomationStep {
  id           String             @id @default(cuid())
  automationId String
  position     Int
  kind         AutomationStepKind
  text         String?            @db.Text
  delaySeconds Int?
  tagId        String?
  buttons      Json?
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  automation   Automation         @relation(fields: [automationId], references: [id], onDelete: Cascade)
  tag          Tag?               @relation(fields: [tagId], references: [id], onDelete: SetNull)

  @@unique([automationId, position])
  @@index([automationId, position])
}

model AutomationReel {
  id           String     @id @default(cuid())
  automationId String
  externalId   String     @db.VarChar(120)
  title        String?    @db.VarChar(160)
  permalink    String?    @db.VarChar(500)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, externalId])
  @@index([automationId])
}

// Somente metadados. OAuth, tokens e integrações serão definidos em outra etapa.
model SocialAccount {
  id          String                 @id @default(cuid())
  workspaceId String
  platform    SocialPlatform
  externalId  String?
  username    String?
  status      SocialConnectionStatus @default(NOT_CONNECTED)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(3)
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId])
}

// Controle persistente, compartilhado entre processos, sem armazenar e-mails.
model LoginRateLimit {
  key       String   @id
  attempts  Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)
}
