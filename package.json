{
  "name": "automacao-instagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:runtime": "node --test tests/runtime/*.test.mjs",
    "test:docker": "node tests/docker/smoke.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "test:execution": "node tests/docker/execution.mjs",
    "test:worker": "node tests/docker/worker-flow.mjs",
    "test:webhook-reception": "node tests/docker/webhook-reception.mjs",
    "instagram:webhooks:check": "tsx scripts/instagram-webhooks.ts",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "owner:setup": "tsx scripts/setup-owner.ts",
    "owner:password": "tsx scripts/reset-password.ts",
    "instagram:check": "tsx scripts/check-instagram.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@inquirer/prompts": "8.7.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.6",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
