{$PULSO_WEBHOOK_DOMAIN} {
  log {
    output stdout
    format filter {
      wrap json
      fields {
        request>headers delete
        request>uri delete
        resp_headers delete
      }
    }
  }
  route {
    @callback {
      path /api/webhooks/instagram
      method GET POST
    }
    handle @callback {
      request_body {
        max_size 10MB
      }
      reverse_proxy web:3000 {
        header_up -Authorization
        header_up -Cookie
      }
    }
    respond 404
  }
}
