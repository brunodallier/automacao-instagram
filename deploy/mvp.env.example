# Copiar como deploy/production.env somente na implantação autorizada.
# Sem tokens, senhas ou URLs com credenciais; secrets são arquivos privados.
PULSO_DOMAIN=pulso.brunodallier.com.br
PULSO_PUBLIC_URL=https://pulso.brunodallier.com.br
PULSO_DB_NAME=pulso
PULSO_DB_USER=pulso
PULSO_BIND_IP=0.0.0.0
PULSO_HTTP_PORT=80
PULSO_HTTPS_PORT=443
PULSO_IMAGE=pulso:production
PULSO_TOOLS_IMAGE=pulso:tools
PULSO_BACKUP_IMAGE=pulso:backup
INSTAGRAM_API_VERSION=v25.0
INSTAGRAM_SEND_MODE=disabled
INSTAGRAM_META_VALIDATED=false
INSTAGRAM_WEBHOOK_ENABLED=false
INSTAGRAM_EXECUTION_ACCOUNT_ID=
INSTAGRAM_TEST_COMMENT_ID=
INSTAGRAM_TEST_RECIPIENT_ID=
# Preencher somente após escolher e validar o armazenamento externo.
RESTIC_REPOSITORY=
