# Configuração pública do Compose. Credenciais ficam em deploy/secrets/.
PULSO_DOMAIN=pulso.seu-dominio.example
PULSO_PUBLIC_URL=https://pulso.seu-dominio.example
PULSO_DB_USER=pulso
PULSO_DB_NAME=pulso
PULSO_IMAGE=pulso:production
PULSO_TOOLS_IMAGE=pulso:tools
PULSO_BACKUP_IMAGE=pulso:backup
INSTAGRAM_API_VERSION=v25.0
# Bloqueios independentes da leitura do perfil. Não habilitar sem autorização.
INSTAGRAM_SEND_MODE=disabled
INSTAGRAM_META_VALIDATED=false
INSTAGRAM_WEBHOOK_ENABLED=false
INSTAGRAM_EXECUTION_ACCOUNT_ID=
INSTAGRAM_TEST_COMMENT_ID=
INSTAGRAM_TEST_RECIPIENT_ID=
# Somente para compose.webhooks.yaml, após autorização do callback separado.
PULSO_WEBHOOK_DOMAIN=
# Somente depois de escolher armazenamento externo e configurar suas credenciais.
RESTIC_REPOSITORY=
